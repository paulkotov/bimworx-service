# --- APS credentials (required) ---
APS_CLIENT_ID="your_client_id_from_developer_panel"
APS_CLIENT_SECRET="your_client_secret"

# US (default) | EMEA | AUS | CAN | DEU | IND | JPN | GBR
APS_REGION="US"

# --- OSS bucket for synced models ---
# Globally unique, lowercase letters / numbers / underscore / hyphen.
# Leave empty to auto-derive from APS_CLIENT_ID hash.
APS_BUCKET_KEY=""
# transient (24h) | temporary (30d) | persistent
APS_BUCKET_POLICY="temporary"

# --- Google Drive source (required) ---
# Folder ID from the share URL: drive.google.com/drive/folders/<THIS PART>
# The folder must be shared as "Anyone with the link can view".
GOOGLE_DRIVE_FOLDER_ID=""
# A Google API key with Drive API enabled (no OAuth needed for public folders).
# https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=""
# Optional: comma-separated extensions the server will consider for sync.
GOOGLE_DRIVE_FILE_EXTENSIONS=".rvt,.rfa,.nwd,.nwc,.ifc"

# --- Sync behaviour ---
# How often (ms) to poll Model Derivative when the webhook can't reach us.
SYNC_POLL_INTERVAL_MS=5000
# How long (ms) to wait for translation before giving up.
SYNC_MANIFEST_TIMEOUT_MS=600000

# --- Webhooks / callbacks ---
# Public base URL the APS cloud will POST to (no trailing slash).
# Leave empty to use ngrok locally (see APS_TUNNEL_ENABLED).
APS_WEBHOOK_URL=""
# 36-char max, [A-Z0-9-]. Used to scope/dedupe Model Derivative webhooks.
APS_WEBHOOK_WORKFLOW_ID="bimworx-default-workflow"
# Optional HMAC-SHA1 secret used to verify incoming derivative webhooks.
APS_WEBHOOK_SECRET=""

# --- ngrok tunnel (dev only) ---
# Defaults to true when APS_WEBHOOK_URL is empty.
APS_TUNNEL_ENABLED="true"
# Either set NGROK_AUTHTOKEN here or rely on `ngrok config add-authtoken`.
NGROK_AUTHTOKEN=""

# --- Realtime ---
# Set to a specific origin in production (e.g. https://app.example.com).
REALTIME_CORS_ORIGIN="*"

# --- Server ---
PORT=2504
NODE_ENV="development"
