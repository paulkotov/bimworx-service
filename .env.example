# ── Server ─────────────────────────────────────────────
PORT=2504
NODE_ENV=development

# Secret used to sign the session cookie (any long random string).
SESSION_SECRET="change_me_to_a_long_random_string"

# ── Google OAuth ───────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Enable the Drive API.
# Used both for signing users in and for reading their Revit files on Drive.
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:2504/api/auth/google/callback"

# ── Autodesk Platform Services (APS) ───────────────────
# Create an app at https://aps.autodesk.com/myapps with the
# Data Management API and Model Derivative API enabled.
APS_CLIENT_ID="your_aps_client_id"
APS_CLIENT_SECRET="your_aps_client_secret"
APS_REGION="US" # or "EMEA" for Europe
