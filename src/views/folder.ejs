<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css" type="text/css" />
  <link rel="stylesheet" href="/hubs.css" type="text/css" />
  <link rel="stylesheet" href="/project.css" type="text/css" />
</head>

<body class="app-shell hubs-page">
  <%- include('partials/header') %>

  <main class="hubs-main project-main app-shell__content">
    <nav class="project-breadcrumb" aria-label="Breadcrumb">
      <a href="/hubs">Hubs</a>
      <span aria-hidden="true">/</span>
      <a href="<%= page.projectHref %>">Project</a>
      <% if (page.showParent) { %>
        <span aria-hidden="true">/</span>
        <a href="<%= page.parentHref %>"><%= page.parentName %></a>
      <% } %>
      <span aria-hidden="true">/</span>
      <span class="project-breadcrumb__current"><%= page.folderName %></span>
    </nav>

    <% if (page.error) { %>
      <section class="hubs-card is-error">
        <h1>Could not load folder</h1>
        <p><%= page.error %></p>
        <a class="hubs-button hubs-button--ghost" href="<%= page.projectHref %>">Back to project</a>
      </section>
    <% } else { %>
      <header class="project-header">
        <h1 class="hubs-title">
          <span class="project-folder__icon" aria-hidden="true">📁</span>
          <%= page.folderName %>
        </h1>
        <p class="hubs-meta"><%= page.summary %></p>
      </header>

      <div class="project-folder__actions">
        <% if (page.showParent) { %>
          <a class="hubs-button hubs-button--ghost" href="<%= page.parentHref %>">↑ Up one level</a>
        <% } %>
        <a class="hubs-button hubs-button--ghost" href="<%= page.projectHref %>">Project overview</a>
        <button type="button" class="hubs-button" id="upload-btn">⬆ Upload files</button>
        <input type="file" id="upload-input" multiple hidden />
      </div>
      <p class="hubs-hint project-upload-status" id="upload-status" hidden></p>

      <section class="hubs-card project-folder">
        <% if (page.isEmpty) { %>
          <p class="hubs-hint">This folder is empty.</p>
        <% } else { %>
          <ul class="project-contents">
            <% page.entries.forEach(function (entry) { %>
              <%- include('partials/contentEntry', { entry: entry }) %>
            <% }) %>
          </ul>
        <% } %>
      </section>
    <% } %>
  </main>

  <% if (!page.error) { %>
    <script>
      window.__UPLOAD_ENDPOINT__ = "<%= page.showUpload ? page.uploadEndpoint : '' %>";
    </script>
    <script src="/folder.js" defer></script>
  <% } %>
</body>

</html>
