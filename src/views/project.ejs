<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css" type="text/css" />
  <link rel="stylesheet" href="/hubs.css" type="text/css" />
  <link rel="stylesheet" href="/project.css" type="text/css" />
</head>

<body class="app-shell hubs-page">
  <%- include('partials/header') %>

  <main class="hubs-main project-main app-shell__content">
    <nav class="project-breadcrumb" aria-label="Breadcrumb">
      <a href="/hubs">Hubs</a>
      <span aria-hidden="true">/</span>
      <span class="project-breadcrumb__current"><%= page.projectName %></span>
    </nav>

    <% if (page.error) { %>
      <section class="hubs-card is-error">
        <h1>Could not load project</h1>
        <p><%= page.error %></p>
        <a class="hubs-button hubs-button--ghost" href="/hubs">Back to hubs</a>
      </section>
    <% } else { %>
      <header class="project-header">
        <h1 class="hubs-title"><%= page.projectName %></h1>
        <p class="hubs-meta"><%= page.projectId %></p>
      </header>

      <section class="hubs-card project-info">
        <h2>Details</h2>
        <dl class="project-detail-list">
          <% page.fields.forEach(function (field) { %>
            <div>
              <dt><%= field.label %></dt>
              <dd><%= field.value %></dd>
            </div>
          <% }) %>
        </dl>
      </section>

      <section class="project-folders">
        <h2 class="project-section-title">Folders &amp; documents</h2>

        <% if (!page.hasFolders) { %>
          <p class="hubs-hint">No accessible top folders for this project.</p>
        <% } %>

        <% page.folders.forEach(function (folder) { %>
          <article class="hubs-card project-folder">
            <div class="project-folder__head">
              <h3>
                <span class="project-folder__icon" aria-hidden="true">📁</span>
                <%= folder.name %>
              </h3>
              <% if (folder.countLabel) { %>
                <span class="hubs-meta"><%= folder.countLabel %></span>
              <% } %>
            </div>

            <% if (folder.contentsError) { %>
              <p class="hubs-hint is-error"><%= folder.contentsError %></p>
            <% } else if (folder.isEmpty) { %>
              <p class="hubs-hint">Empty folder.</p>
            <% } else { %>
              <ul class="project-contents">
                <% folder.entries.forEach(function (entry) { %>
                  <%- include('partials/contentEntry', { entry: entry }) %>
                <% }) %>
              </ul>
            <% } %>
          </article>
        <% }) %>
      </section>
    <% } %>
  </main>
</body>

</html>
