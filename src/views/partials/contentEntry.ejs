<li class="<%= entry.rowClass %>">
  <% if (entry.isFolder) { %>
    <a class="project-entry__link" href="<%= entry.folderHref %>">
      <span class="project-entry__icon" aria-hidden="true">📁</span>
      <div class="project-entry__body">
        <span class="project-entry__name"><%= entry.name %></span>
        <span class="hubs-meta"><%= entry.meta %></span>
      </div>
      <span class="project-entry__arrow" aria-hidden="true">→</span>
    </a>
  <% } else { %>
    <span class="project-entry__icon" aria-hidden="true">📄</span>
    <div class="project-entry__body">
      <span class="project-entry__name"><%= entry.name %></span>
      <span class="hubs-meta"><%= entry.meta %></span>
    </div>
    <div class="project-entry__actions">
      <% if (entry.isRevit) { %>
        <a
          class="project-entry__action project-entry__action--primary"
          href="<%= entry.viewHref %>"
          title="<%= entry.viewTitle %>"
          aria-label="<%= entry.viewTitle %>"
        >
          <span aria-hidden="true">👁</span>
          <span class="project-entry__action-text">View</span>
        </a>
        <a
          class="project-entry__action"
          href="<%= entry.detailsHref %>"
          title="<%= entry.detailsTitle %>"
          aria-label="<%= entry.detailsTitle %>"
        >
          <span aria-hidden="true">ⓘ</span>
          <span class="project-entry__action-text">Details</span>
        </a>
      <% } %>
      <a
        class="project-entry__action"
        href="<%= entry.downloadHref %>"
        title="<%= entry.downloadTitle %>"
        aria-label="<%= entry.downloadTitle %>"
      >
        <span aria-hidden="true">⬇</span>
        <span class="project-entry__action-text">Download</span>
      </a>
      <button
        type="button"
        class="project-entry__action project-entry__action--danger"
        data-delete-url="<%= entry.deleteHref %>"
        data-delete-name="<%= entry.name %>"
        title="<%= entry.deleteTitle %>"
        aria-label="<%= entry.deleteTitle %>"
      >
        <span aria-hidden="true">🗑</span>
        <span class="project-entry__action-text">Delete</span>
      </button>
    </div>
  <% } %>
</li>
