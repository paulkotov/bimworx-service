<header class="app-header">
  <a class="app-header__brand" href="<%= brandHref %>">BimWorx</a>
  <nav class="app-header__nav" aria-label="Main">
    <% if (authenticated) { %>
      <a class="<%= hubsClass %>" href="/hubs">Hubs</a>
      <a class="app-header__link" href="<%= logoutUrl %>">Sign out</a>
    <% } else { %>
      <a class="<%= loginClass %>" href="<%= loginUrl %>">Login</a>
    <% } %>
  </nav>
</header>
